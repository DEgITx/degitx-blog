---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIAL } from '../consts.js';
import {
  EDUCATION,
  PROJECTS,
  PUBLICATIONS,
  ROLES,
  yearsOfExperience,
} from '../data/resume';

const years = yearsOfExperience();
const url = `${SITE.url}/about/`;

const schema = [
  {
    '@type': 'ProfilePage',
    '@id': `${url}#page`,
    url,
    name: 'About Alexey Kasyanchuk',
    isPartOf: { '@id': `${SITE.url}/#website` },
    mainEntity: { '@id': `${SITE.url}/#person` },
  },
  {
    // Extends the Person node emitted site-wide in BaseHead.
    '@type': 'Person',
    '@id': `${SITE.url}/#person`,
    homeLocation: {
      '@type': 'Place',
      address: { '@type': 'PostalAddress', addressLocality: 'Minsk', addressCountry: 'BY' },
    },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: EDUCATION.university,
      department: EDUCATION.faculty,
    },
    worksFor: {
      '@type': 'Organization',
      name: ROLES[0]!.company,
    },
    hasOccupation: ROLES.map((role) => ({
      '@type': 'Occupation',
      name: role.title,
      occupationLocation: { '@type': 'Place', name: role.company },
      skills: role.stack.join(', '),
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'About', item: url },
    ],
  },
];

const period = (from: number, to?: number) => (to ? (to === from ? `${from}` : `${from} — ${to}`) : `${from} — now`);
---

<BaseLayout
  title="About"
  description={`Alexey Kasyanchuk (DEgITx) — senior software engineer with ${years}+ years in C/C++, Android NDK, embedded Linux and multimedia. Career history, projects and publications.`}
  type="profile"
  schema={schema}
>
  <div class="container-prose py-14 sm:py-20">
    <!-- Intro -->
    <header class="flex flex-col gap-6 sm:flex-row sm:items-center">
      <img
        src={SITE.avatar}
        alt="Alexey Kasyanchuk"
        width="112"
        height="112"
        loading="eager"
        decoding="async"
        class="size-24 shrink-0 rounded-2xl border border-[var(--color-border)] object-cover sm:size-28"
      />
      <div>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Alexey Kasyanchuk</h1>
        <p class="mt-2 text-[var(--color-fg-muted)]">
          Senior Software Engineer &middot; Minsk, Belarus
        </p>
        <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Profiles">
          {
            SOCIAL.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="me noopener noreferrer"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--color-border)] px-2.5 py-1 text-xs text-[var(--color-fg-muted)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
                >
                  <Icon name={s.icon} size={13} />
                  {s.name}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${SITE.email}`}
              class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--color-border)] px-2.5 py-1 text-xs text-[var(--color-fg-muted)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
            >
              <Icon name="mail" size={13} />
              {SITE.email}
            </a>
          </li>
        </ul>
      </div>
    </header>

    <p class="mt-10 text-lg leading-relaxed text-pretty">
      I'm a software developer with <strong>{years} years</strong> of commercial experience, mostly
      in the layer between hardware and application code: C and C++ on embedded Linux and Android,
      multimedia pipelines, set-top box platforms and board bring-up.
    </p>

    <!-- Experience -->
    <section class="mt-16" aria-labelledby="experience">
      <h2
        id="experience"
        class="text-xs font-semibold tracking-widest text-[var(--color-fg-subtle)] uppercase"
      >
        Experience
      </h2>

      <ol class="mt-6 space-y-3">
        {
          ROLES.map((role) => (
            <li class="rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-elevated)] p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="text-lg font-semibold tracking-tight">
                  {role.company}
                  {role.via && (
                    <span class="font-normal text-[var(--color-fg-subtle)]"> / {role.via}</span>
                  )}
                </h3>
                <span class="font-mono text-xs whitespace-nowrap text-[var(--color-fg-subtle)]">
                  {period(role.from, role.to)}
                </span>
              </div>

              <p class="mt-1 text-sm font-medium text-[var(--color-accent)]">{role.title}</p>
              <p class="mt-3 leading-relaxed text-[var(--color-fg-muted)]">{role.summary}</p>

              <ul class="mt-4 flex flex-wrap gap-1.5">
                {role.stack.map((tech) => (
                  <li class="rounded border border-[var(--color-border)] px-1.5 py-0.5 font-mono text-[11px] text-[var(--color-fg-subtle)]">
                    {tech}
                  </li>
                ))}
              </ul>

              {role.logo && (
                /* Brand logos are dark ink on white, so they sit on their own
                   white plate rather than being inverted for dark mode. */
                <ul class="mt-5 flex flex-wrap items-center gap-2.5">
                  {role.logo.map((logo) => (
                    <li class="rounded-lg bg-white px-3 py-2 ring-1 ring-[var(--color-border)]">
                      <img
                        src={logo.src}
                        alt={logo.alt}
                        width={logo.width}
                        height={logo.height}
                        loading="lazy"
                        decoding="async"
                        class="block h-[22px] w-auto object-contain"
                      />
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <!-- Education -->
    <section class="mt-16" aria-labelledby="education">
      <h2
        id="education"
        class="text-xs font-semibold tracking-widest text-[var(--color-fg-subtle)] uppercase"
      >
        Education
      </h2>
      <dl
        class="mt-6 grid gap-x-8 gap-y-3 rounded-[var(--radius-card)] border border-[var(--color-border)] bg-[var(--color-elevated)] p-6 text-sm sm:grid-cols-[8rem_1fr]"
      >
        <dt class="text-[var(--color-fg-subtle)]">University</dt>
        <dd>{EDUCATION.university}</dd>
        <dt class="text-[var(--color-fg-subtle)]">Faculty</dt>
        <dd>{EDUCATION.faculty}</dd>
        <dt class="text-[var(--color-fg-subtle)]">Degree</dt>
        <dd>{EDUCATION.degree}</dd>
        <dt class="text-[var(--color-fg-subtle)]">Focus</dt>
        <dd>{EDUCATION.focus}</dd>
        <dt class="text-[var(--color-fg-subtle)]">Thesis</dt>
        <dd>{EDUCATION.thesis}</dd>
      </dl>
    </section>

    <!-- Projects -->
    <section class="mt-16" aria-labelledby="projects">
      <h2
        id="projects"
        class="text-xs font-semibold tracking-widest text-[var(--color-fg-subtle)] uppercase"
      >
        Open source
      </h2>
      <ul class="mt-6 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
        {
          PROJECTS.map((project) => (
            <li>
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 py-4"
              >
                <span class="min-w-0 flex-1">
                  <span class="block font-mono text-sm font-medium transition-colors group-hover:text-[var(--color-accent)]">
                    {project.name}
                  </span>
                  <span class="mt-1 block text-sm text-[var(--color-fg-muted)]">
                    {project.description}
                  </span>
                </span>
                <Icon
                  name="arrow"
                  size={16}
                  class="shrink-0 -rotate-45 text-[var(--color-fg-subtle)] transition-transform duration-300 ease-[var(--ease-out-quint)] group-hover:translate-x-0.5"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Publications -->
    <section class="mt-16" aria-labelledby="publications">
      <h2
        id="publications"
        class="text-xs font-semibold tracking-widest text-[var(--color-fg-subtle)] uppercase"
      >
        Published elsewhere
      </h2>
      <ul class="mt-6 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
        {
          PUBLICATIONS.map((pub) => (
            <li>
              <a
                href={pub.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-4 py-4"
              >
                <span class="min-w-0 flex-1">
                  <span class="block font-medium transition-colors group-hover:text-[var(--color-accent)]">
                    {pub.title}
                  </span>
                  <span class="mt-1 block text-sm text-[var(--color-fg-subtle)]">{pub.outlet}</span>
                </span>
                <Icon
                  name="arrow"
                  size={16}
                  class="shrink-0 -rotate-45 text-[var(--color-fg-subtle)] transition-transform duration-300 ease-[var(--ease-out-quint)] group-hover:translate-x-0.5"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
