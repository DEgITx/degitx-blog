---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts.js';
import { getPosts, getTags } from '../../utils/posts';

const posts = await getPosts();
const tags = await getTags(posts);

const max = Math.max(...tags.map((t) => t.count), 1);

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}/tags/#page`,
    url: `${SITE.url}/tags/`,
    name: 'Topics',
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Topics', item: `${SITE.url}/tags/` },
    ],
  },
];
---

<BaseLayout
  title="Topics"
  description={`All ${tags.length} topics covered on this blog — C++, Android NDK, embedded Linux, GStreamer, MinGW, WinAPI and more.`}
  schema={schema}
>
  <div class="container-page py-14 sm:py-20">
    <header class="max-w-2xl">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Topics</h1>
      <p class="mt-4 leading-relaxed text-[var(--color-fg-muted)]">
        {tags.length} topics across {posts.length} articles. Larger entries have more coverage.
      </p>
    </header>

    <ul class="mt-12 flex flex-wrap gap-2.5">
      {
        tags.map((tag) => (
          <li>
            <a
              href={`/tags/${tag.slug}/`}
              class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-elevated)] px-3.5 py-2 transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
              style={`font-size: ${(0.875 + (tag.count / max) * 0.375).toFixed(3)}rem`}
            >
              {tag.name}
              <span class="font-mono text-xs text-[var(--color-fg-subtle)]">{tag.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
