---
import { SITE, SOCIAL, NAV } from '../consts.js';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[var(--color-border)]">
  <div class="container-page py-12">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <p class="font-semibold tracking-tight">{SITE.title}</p>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-fg-muted)]">
          {SITE.tagline} on C/C++, Android NDK, embedded Linux and multimedia.
        </p>
      </div>

      <nav aria-label="Footer" class="flex flex-col gap-2 text-sm">
        {
          NAV.map((item) => (
            <a
              href={item.href}
              class="text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-fg)]"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="/rss.xml"
          class="text-[var(--color-fg-muted)] transition-colors hover:text-[var(--color-fg)]"
          >RSS</a
        >
      </nav>

      <ul class="flex gap-1.5" aria-label="Elsewhere">
        {
          SOCIAL.map((s) => (
            <li>
              <a
                href={s.url}
                rel="me noopener noreferrer"
                target="_blank"
                title={s.name}
                class="grid size-9 place-items-center rounded-lg border border-[var(--color-border)] text-[var(--color-fg-muted)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
              >
                <Icon name={s.icon} size={17} />
                <span class="sr-only">{s.name}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={`mailto:${SITE.email}`}
            title="Email"
            class="grid size-9 place-items-center rounded-lg border border-[var(--color-border)] text-[var(--color-fg-muted)] transition-colors hover:border-[var(--color-border-strong)] hover:text-[var(--color-fg)]"
          >
            <Icon name="mail" size={17} />
            <span class="sr-only">Email</span>
          </a>
        </li>
      </ul>
    </div>

    <p class="mt-10 text-xs text-[var(--color-fg-subtle)]">
      &copy; {year} {SITE.author}. Built with Astro.
    </p>
  </div>
</footer>
